# Run Ledger PostgreSQL Database Configuration
DATABASE_URL=postgresql://ledger:ledger@ledger:5432/ledger

# Trusted Control Plane API Configuration
API_PORT=8080
HOST_PORT=8080
LOG_LEVEL=info
ENVIRONMENT=production
